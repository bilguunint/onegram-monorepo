# Copy to .env and fill in. NEVER commit .env (it holds private keys).

# RPC endpoint for Polygon Amoy testnet.
# Free: https://www.alchemy.com  or  https://www.infura.io
# Or the public endpoint below (rate-limited):
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Private key of the deployer/admin wallet (testnet only — fund via faucet).
# Faucet: https://faucet.polygon.technology  (select Amoy)
DEPLOYER_PRIVATE_KEY=0xyourtestnetprivatekey

# Address that gets MINTER/BURNER/PAUSER roles. Usually the same as the
# deployer for testing. This is the wallet your Cloud Functions sign with.
BACKEND_ADMIN_ADDRESS=0xyourbackendaddress

# Set after deploying (printed by scripts/deploy.js):
ONEGRAM_TOKEN_ADDRESS=

# Optional: for contract verification on the Amoy explorer.
POLYGONSCAN_API_KEY=
