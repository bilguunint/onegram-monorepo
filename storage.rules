rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
      );
    }

    // Product images — public read (нийтэд харагдана), admin зөвхөн бичих.
    // 5MB-ээс дээш файл хориглоно, зөвхөн image content type.
    match /products/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // Investment contracts (closeInvestment flow) — admin only.
    // 10MB-ээс дээш файл хориглоно.
    match /contracts/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // Withdraw attachments — баталгаажуулалтын файлууд (зураг, PDF).
    // Зөвхөн admin (seller doc-той орно) бичнэ. 10MB-ээс дээш файл хориглоно.
    // image/* эсвэл application/pdf content type.
    match /withdraws/{withdrawId}/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType == 'application/pdf'
        );
      allow delete: if isAdmin();
    }

    // Бусад бүх зам хориглох.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
